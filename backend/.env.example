JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
JWT_EXPIRES_IN="7d"
SESSION_SECRET=""
CSRF_SECRET=""

# Encryption key for sensitive data (64 hex chars = 32 bytes)
ENCRYPTION_KEY=""

# AI API Keys
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# Google OAuth - https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
